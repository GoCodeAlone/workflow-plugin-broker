{
  "version": "1",
  "contracts": [
    {
      "kind": "module",
      "type": "broker.nats",
      "mode": "strict_proto",
      "config": "workflow.plugin.broker.v1.NATSModuleConfig"
    },
    {
      "kind": "step",
      "type": "step.broker_publish",
      "mode": "strict_proto",
      "config": "workflow.plugin.broker.v1.BrokerPublishConfig",
      "input": "workflow.plugin.broker.v1.BrokerPublishInput",
      "output": "workflow.plugin.broker.v1.BrokerPublishOutput"
    },
    {
      "kind": "step",
      "type": "step.broker_subscribe",
      "mode": "strict_proto",
      "config": "workflow.plugin.broker.v1.BrokerSubscribeConfig",
      "input": "workflow.plugin.broker.v1.BrokerSubscribeInput",
      "output": "workflow.plugin.broker.v1.BrokerSubscribeOutput"
    }
  ]
}
